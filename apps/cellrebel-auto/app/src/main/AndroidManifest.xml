<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- # T-tilemap (2026-09-08)：运行台地图卡的 OSM 瓦片底图（osmdroid）。本 app 此前
         # 完全离线所以未声明联网权限；这两个权限仅服务瓦片下载与连通性探测
         # （TileNetworkGate——无网自动回退抽象 Canvas 地图）。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- # WRITE_EXTERNAL_STORAGE 刻意不申请：osmdroid 6.x 的瓦片缓存已显式配置到
         # 应用内部存储（TilePlanMapCard.kt 的 OsmdroidBootstrap.ensure → cacheDir），
         # 按需最小化，无外部存储访问。 -->

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- # Android 11+ 需要声明可见的外部应用包名 -->
    <queries>
        <package android:name="com.cellrebel.mobile" />
        <package android:name="com.hopefactory2021.fakegpslocation" />
        <!-- R43 (Sol GREEN-review-2 F1): the frozen-contract provider (production + bench), required
             for package visibility before binding IEnvironmentControlV1 (Android 11+ filtering).
             The glmbench lane provider must be listed too — without it the lane build cannot even
             SEE its own provider (discovery NameNotFound, bindService fails) on Android 11+. -->
        <package android:name="name.caiyao.fakegps" />
        <package android:name="name.caiyao.fakegps.bench" />
        <package android:name="name.caiyao.fakegps.glmbench" />
        <!-- fakexxx lane provider (Wave-1 integrated rename build) — same visibility
             requirement: without this the lane build cannot see its own provider. -->
        <package android:name="name.caiyao.fakegps.fakexxx" />
    </queries>

    <!-- # T3 (P1.2)：签名级远程控制权限。仅同签名应用（+ uid 0/root adb，框架组件权限
         # 检查对 root 豁免）可以驱动引擎；名字按 applicationId 命名空间隔离，
         # 多 lane 共存安装时互不可控。 -->
    <permission
        android:name="${applicationId}.permission.REMOTE_CONTROL"
        android:protectionLevel="signature" />

    <application
        android:name=".CellRebelAutoApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CellRebelAuto">

        <!-- # 主界面 Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CellRebelAuto">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- # T11c 跨 app deep link：fakexxx-auto://providers 直达 Provider 页（A2）。
                 # 仅导航：intent 只被解析成目标 Screen，不携带数据、不执行任何动作，
                 # 因此无权限门槛（exported 本就因 LAUNCHER 必需）。往返约定见
                 # docs/deep-links.md（对侧为 fakexxx-map://pending）。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="fakexxx-auto"
                    android:host="providers" />
            </intent-filter>
        </activity>

        <!-- # 无障碍服务（新路径：automation 包下） -->
        <service
            android:name=".automation.AutomationService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- # T3 (P1.2)：无人值守运维的 exported broadcast 入口（详见 docs/remote-control.md）。
             # android:permission 让系统在分发前拒绝未持权限的发送方（root 豁免）；
             # receiver 内部还有一道防御性检查 + Log.w（含 caller 标识）。 -->
        <receiver
            android:name=".remote.RemoteControlReceiver"
            android:exported="true"
            android:permission="${applicationId}.permission.REMOTE_CONTROL">
            <intent-filter>
                <action android:name="${applicationId}.remote.control.START_PLAN" />
                <action android:name="${applicationId}.remote.control.STOP" />
                <action android:name="${applicationId}.remote.control.RESUME" />
                <action android:name="${applicationId}.remote.control.RESET_PLAN" />
                <action android:name="${applicationId}.remote.control.STATUS" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
