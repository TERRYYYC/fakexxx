<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only integration probe (§7 walking skeleton).

  exported=true so `adb shell am start` can drive it without a launcher tile.
  This manifest is src/debug, so the entry point cannot reach a release build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.example.cellrebelauto.integration.v1.HandshakeProbeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="EC v1 handshake probe" />
        <activity
            android:name="com.example.cellrebelauto.integration.v1.FullLoopProbeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="EC v1 full loop probe" />
        <!-- P10 (G2 §5B/§5C): debug-only provider-revoke command surface with
             exact-window gating over durable Room state. src/debug only. -->
        <activity
            android:name="com.example.cellrebelauto.integration.v1.ProviderRevokeCollectorActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="EC v1 P10 provider-revoke collector" />
        <!-- G2 §5A: debug-only A+ 10-address seed/run surface — seeds the plan
             (with trust-target coordinates) and starts a run via the product's
             own AutomationService entry. src/debug only. -->
        <activity
            android:name="com.example.cellrebelauto.integration.v1.APlusSeedActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="EC v1 A+ §5A seed/run" />
    </application>
</manifest>
