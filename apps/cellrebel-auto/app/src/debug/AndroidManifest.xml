<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only integration probe (§7 walking skeleton).

  exported=true so `adb shell am start` can drive it without a launcher tile.
  This manifest is src/debug, so the entry point cannot reach a release build.

  #12 PLAN RE-RUN SEQUENCE (the Auto half of it lives in the PRODUCT Plan
  screen — "⟲ Reset plan & re-run", visible once the plan is complete or an
  attempt is stuck RECOVERY_REQUIRED — this seam documents the whole sequence
  because the operator drives it from both sides):

    1. AUTO  Plan screen → Reset plan & re-run → confirm. Re-imports the SAME
            worklist as a NEW plan generation (tasks restart pending, attempts/
            quota projections start clean; old attempts stay in History) and
            appends a PLAN_RESET row to auto_audit_events.
    2. QWY   adb shell am start -n <providerPkg>/
            name.caiyao.fakegps.integration.v1.FaultCollectorActivity
            with string extra cmd=schedule_reset
            — new schedule generation (version+1, exhausted cleared, pointer to
            first item) + FULL contract durable wipe (lease/idempotency/audit).
    3. RE-PAIRING — REQUIRED, not optional: step 2 wipes the provider's
            pairing rows too. The first Auto handshake fail-closes NOT_PAIRED
            and records a candidate; approve it via
            adb shell am start -n <providerPkg>/
            name.caiyao.fakegps.integration.v1.PairingApprovalActivity
            (list, then approve naming BOTH the applicationId AND the signer
            digest extras — §6.5 forbids silent re-grants).
    4. AUTO  Start Plan.

  <providerPkg> is this build's selected provider principal (debug/bench lane:
  name.caiyao.fakegps.bench; glmbench lane: name.caiyao.fakegps.glmbench) —
  the confirm dialog in the Plan screen prints the exact commands.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.example.cellrebelauto.integration.v1.HandshakeProbeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="EC v1 handshake probe" />
        <activity
            android:name="com.example.cellrebelauto.integration.v1.FullLoopProbeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="EC v1 full loop probe" />
        <!-- P10 (G2 §5B/§5C): debug-only provider-revoke command surface with
             exact-window gating over durable Room state. src/debug only. -->
        <activity
            android:name="com.example.cellrebelauto.integration.v1.ProviderRevokeCollectorActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="EC v1 P10 provider-revoke collector" />
        <!-- G2 §5A: debug-only A+ 10-address seed/run surface — seeds the plan
             (order + journeyCaseId + requiredSuccesses only; KB-8 = Auto does
             NOT import coordinates) and starts a run via the product's own
             AutomationService entry. src/debug only. -->
        <activity
            android:name="com.example.cellrebelauto.integration.v1.APlusSeedActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="EC v1 A+ §5A seed/run" />
    </application>
</manifest>
