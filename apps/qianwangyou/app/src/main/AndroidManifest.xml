<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Android Settings discovers candidates for "Select mock location app" through this legacy
        declaration even though modern Android grants the real authority through the mock_location
        app-op. Mock location is an intentional product capability here, so lint's test-only
        assumption does not apply to the release manifest.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_MOCK_LOCATION"
        tools:ignore="MockLocation" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:icon="@drawable/ic_lan"
        android:label="@string/app_name"
        android:persistent="true"
        android:theme="@style/AppTheme.NoActionBar">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="FakeGPS - Device Info Spoofer" />
        <meta-data
            android:name="xposedminversion"
            android:value="30" />
        <!--
            Opt into the modern XSharedPreferences transport. Without this flag (or
            xposedminversion > 92) the framework never triggers hookNewXSP, so
            MODE_WORLD_READABLE is rejected and the prefs file stays in the app's private
            dir where hooked apps cannot read it (canRead=false). With the flag, the
            framework redirects getPreferencesDir() to the daemon-provisioned safe-zone
            (SELinux u:object_r:xposed_data:s0, 0755) that target app processes can read.
            This is the transport that replaces the ContentProvider path, which Android 11+
            package-visibility filtering blocks entirely.
        -->
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <activity
            android:name=".ui.ComposeActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Legacy activities kept for reference during migration -->
        <activity
            android:name=".ui.activity.SplashActivity"
            android:label="@string/app_name"
            android:exported="false" />

        <activity
            android:name=".ui.activity.MainActivity"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <!--
            exported=false (review FC-6): this provider was world-readable with no permission, so
            ANY app on the device could read the full spoof profile — including the app under test,
            which turns the tool itself into the giveaway. Nothing outside this APK needs it: the
            hook stopped querying it when the transport moved to XSharedPreferences, and the only
            remaining callers (VerifyViewModel / ConfigPrefsSync / SpoofSettings) run in this
            process, where same-uid access does not require export.
        -->
        <provider
            android:name=".data.AppInfoProvider"
            android:authorities="${applicationId}.data.AppInfoProvider"
            android:exported="false" />

        <!--
            Stable-release verification runs here, never in the configuration process. The service
            receives only request correlation metadata; it reads the published payload itself and
            returns public-API observations. Non-exported prevents another app from driving it.
        -->
        <service
            android:name=".verify.HookVerificationService"
            android:exported="false"
            android:process=":hook_verify"
            android:stopWithTask="true" />

        <service
            android:name=".mockprovider.MockProviderService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
            Environment Control contract v1 (§6.1). This is the ONLY service here
            that is exported, and it has to be: CellRebel Auto is a separate app
            with a separate uid, and the whole contract is a cross-app bind on a
            frozen explicit ComponentName (§1188). exported=false would make
            bindService() fail in a way Auto cannot tell apart from "qwy is not
            installed".

            Exported does NOT mean open. There is no intent-filter, so only an
            explicit ComponentName reaches it, and every call resolves its real
            caller from Binder.getCallingUid() and must match an operator-approved
            (applicationId, signerDigest) pairing (§6.5, INV-02). An unknown
            caller gets NOT_PAIRED, never environment control.

            No android:process: the provider runs in the main process. The durable
            stores behind it are MODE_PRIVATE SharedPreferences with a
            single-writer rule (§6.6 L3), and a second process writing them is
            exactly the split-brain that rule forbids — qwy's :hook_verify process
            must never touch these namespaces.
        -->
        <service
            android:name=".integration.v1.EnvironmentControlService"
            android:exported="true" />

        <!--
            Private system_server oracle registrar. It intentionally has no intent filter and
            stays in the main process. Export is required for the explicit cross-uid bind, while
            every registrar transaction independently requires Binder caller UID 1000.
        -->
        <service
            android:name=".oracle.OracleBridgeService"
            android:exported="true" />

    </application>

</manifest>
