<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only surfaces. src/debug so none of this can ship. Two coexisting
  families — additions to this file must APPEND, never replace (ff59c27
  wholesale-replaced it and silently deleted the acceptance harness; guarded
  by DebugAcceptanceManifestGuardTest):

  1. Acceptance harness (signature/DUMP-gated): hook acceptance probes and the
     shell-only seam that seeds isolated .bench data and guarantees trap cleanup.
  2. Operator pairing approval for Environment Control v1 (§6.5):
     exported=true so adb can drive it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="${applicationId}.permission.RUN_HOOK_ACCEPTANCE"
        android:protectionLevel="signature" />

    <application android:name=".probe.HookAcceptanceApplication">
        <activity
            android:name=".probe.HookAcceptanceActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="${applicationId}.permission.RUN_HOOK_ACCEPTANCE"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <!-- Shell-only debug seam: seeds isolated .bench data and guarantees trap cleanup. -->
        <activity
            android:name=".mockprovider.MockProviderAcceptanceActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity
            android:name="name.caiyao.fakegps.integration.v1.PairingApprovalActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="EC v1 pairing approval" />
    </application>

</manifest>
